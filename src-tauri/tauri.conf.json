{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickTranslate",
  "version": "1.2.0",
  "identifier": "com.quicktranslate.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "popup",
        "title": "QuickTranslate",
        "url": "index.html",
        "width": 520,
        "height": 380,
        "minWidth": 360,
        "minHeight": 180,
        "maxWidth": 960,
        "maxHeight": 720,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "skipTaskbar": true,
        "shadow": true,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost data:; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' data: blob:; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/com.quicktranslate.desktop/ocr-plugins/**"]
      }
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "resources": {
      "resources/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2MkYxQTE3N0NDNDIxNzAKUldSd0ljUjhGeG92cHFjUnFSOUEzUC9LaGk3WUFrbS9PaEU4WkVTLy9tejRFSnhQdFgxUUhRZ1AK",
      "endpoints": ["https://github.com/MYPoems/QuickTranslate/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
