{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-commands",
  "description": "What the settings window may ask of the backend: read and save settings, test services, manage plugins and updates",
  "windows": ["settings"],
  "permissions": [
    "allow-get-appearance-preferences",
    "allow-get-key-status",
    "allow-check-shortcut",
    "allow-open-api-key-page",
    "allow-get-onboarding",
    "allow-complete-onboarding",
    "allow-test-cloud-ocr",
    "allow-list-vocabulary",
    "allow-set-vocabulary-rules",
    "allow-list-speech-voices",
    "allow-test-cloud-speech",
    "allow-get-speech-plugin-status",
    "allow-install-speech-plugin",
    "allow-cancel-speech-plugin-install",
    "allow-uninstall-speech-plugin",
    "allow-translate-text",
    "allow-copy-translation",
    "allow-clear-translation-cache",
    "allow-install-paddle-ocr-plugin",
    "allow-uninstall-paddle-ocr-plugin",
    "allow-get-settings",
    "allow-save-settings",
    "allow-test-provider",
    "allow-get-diagnostics",
    "allow-check-for-updates",
    "allow-get-update-state",
    "allow-download-update",
    "allow-cancel-update-download",
    "allow-install-update",
    "allow-export-settings-backup",
    "allow-import-settings-backup"
  ]
}
