{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "vocabulary-commands",
  "description": "What the vocabulary window may ask of the backend: manage, review and back up the word book, read aloud",
  "windows": ["vocabulary"],
  "permissions": [
    "allow-get-appearance-preferences",
    "allow-set-vocabulary-collection-open",
    "allow-list-vocabulary",
    "allow-get-vocabulary-entry",
    "allow-collect-vocabulary",
    "allow-generate-vocabulary",
    "allow-review-vocabulary",
    "allow-save-vocabulary-card",
    "allow-adopt-vocabulary-lemma",
    "allow-begin-vocabulary-quiz",
    "allow-submit-vocabulary-quiz",
    "allow-abandon-vocabulary-quiz",
    "allow-delete-vocabulary",
    "allow-set-vocabulary-rules",
    "allow-export-vocabulary",
    "allow-import-vocabulary",
    "allow-get-speech-preferences",
    "allow-stream-cloud-speech",
    "allow-synthesize-speech",
    "allow-stop-speech",
    "allow-copy-translation"
  ]
}
